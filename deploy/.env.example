# Copy to .env on the server (never commit .env). Permissions: chmod 600 .env
POSTGRES_DB=leoway
POSTGRES_USER=leoway
# Required, empty on purpose so compose refuses to start without it. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Image tag loaded by ship.sh, and the LAN port of the web container
LEOWAY_VERSION=latest
LEOWAY_HTTP_PORT=8080
LEOWAY_PUBLIC_BASE_URL=https://leoway.example.org
# 32-byte key for encrypting WebUntis access keys (S01). Generate: openssl rand -base64 32
LEOWAY_KEY_ENCRYPTION_KEY=

# Backups: age public key (the private key is NOT stored on the server)
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/leoway
BACKUP_KEEP_DAYS=7
# Optional: Uptime Kuma push URL, called after every successful backup
BACKUP_HEARTBEAT_URL=
