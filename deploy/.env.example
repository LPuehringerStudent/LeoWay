# Copy to .env on the server (never commit .env). Permissions: chmod 600 .env
POSTGRES_DB=leoway
POSTGRES_USER=leoway
# Required, empty on purpose so compose refuses to start without it. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Image tag loaded by ship.sh, and the LAN port of the web container
LEOWAY_VERSION=latest
LEOWAY_HTTP_PORT=8080
LEOWAY_PUBLIC_BASE_URL=https://leoway.lpuehringer.dev
# 32-byte key for encrypting WebUntis access keys (S01). Generate: openssl rand -base64 32
LEOWAY_KEY_ENCRYPTION_KEY=

# Encrypts the login session cookie (#20). Changing it logs everyone out. Generate: openssl rand -base64 32
LEOWAY_SESSION_KEY=
# WebUntis usernames (lowercase, comma-separated) with the admin role: feed status and health only
LEOWAY_ADMINS=

# Backups: age public key (the private key is NOT stored on the server)
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/leoway
BACKUP_KEEP_DAYS=7
# Optional: Uptime Kuma push URL, called after every successful backup
BACKUP_HEARTBEAT_URL=
# Automatic deploys (#83, auto-deploy.sh). Quiet window: weekdays 1-5 (Mon-Fri, no holidays), Vienna time; "off" disables it.
# AUTO_DEPLOY_KEEP=5 commit-tagged image pairs are kept for rollbacks.
AUTO_DEPLOY_QUIET=1-5,06:00-08:30
# Optional: ntfy topic URL for deploy results, e.g. https://ntfy.example/leoway-deploy
AUTO_DEPLOY_NOTIFY_URL=
