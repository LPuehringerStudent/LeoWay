[Unit]
Description=LeoWay encrypted PostgreSQL backup
After=docker.service
Requires=docker.service
# Stop retrying after 5 failed starts in an hour; Kuma then alerts on the missing heartbeat.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/opt/leoway/deploy/backup.sh
# The catch-up run after a reboot can start before PostgreSQL is ready: retry.
Restart=on-failure
RestartSec=2min
