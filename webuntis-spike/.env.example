# Copy to .env and fill in ONE of the two options. .env is gitignored.

# Option A: WebUntis username and password (the normal WebUntis login form)
UNTIS_USER=
UNTIS_PASS=

# Option C (recommended): username + access key, no password needed
# WebUntis > Profil > Freigaben > "Zugriff über Untis Mobile" > "Schlüssel". Wins over the password.
UNTIS_SECRET=

# Option B: an existing browser session (use this if you log in via Office 365 / 2FA)
# Log in at https://htl-leonding.webuntis.com, open DevTools > Application > Cookies
# and copy the value of the JSESSIONID cookie. Option B wins if both are filled.
UNTIS_SESSION_ID=
